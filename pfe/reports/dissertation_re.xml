<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Mise en page standard avec en-tête et pied de page -->
    <template id="pfe_layout">
        <div class="header" style="font-family:arial">
            <div class="row" style="margin-top:10px; justify-content:center; font-family:arial">
                <div class="col text-center">
                    <h5>
                        <strong>الجمهوريــة الجزائريـــة الديمقراطيــة الشعبيـة</strong>
                        <br/>
                        <strong>وزارة التعليم العالي و البحث الـعلمي</strong>
                        <br/>
                        <strong>République Algérienne Démocratique Populaire</strong>
                        <br/>
                        <strong>Ministère de L’enseignement Supérieur et de La Recherche Scientifique</strong>
                    </h5>
                </div>
            </div>

            <div class="row" style="margin-top:10px; border-top:1px solid black;">

                <!-- العمود الأيسر: فرنسي -->
                <div class="col-5 mt-2" style="text-align: left; direction: ltr;">
                    <span>
                        <small>Ecole Normale Supérieure d’Enseignement Technologique de Skikda</small>
                    </span>
                    <br/>
                    <span>
                        <small>Département de Mathématiques et Informatique</small>
                    </span>
                </div>

                <!-- وسط: شعار -->
                <t t-set="company" t-value="user.company_id"/>
                <div class="col-2 text-center">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 90px;"
                         alt="Logo"/>
                </div>

                <!-- العمود الأيمن: عربي -->
                <div class="col-5 mt-2" style="text-align: right; direction: rtl;">
                    <span>المدرسة العليا لأساتذة التعليم التكنولوجي - سكيكدة</span>
                    <br/>
                    <span>قسم الرياضيات و الإعلام الآلي</span>
                </div>
            </div>
            <br/>
        </div>
        <div class="article o_report_layout_standard">
            <t t-raw="0"/>
        </div>

        <div class="footer o_standard_footer">
            <div class="text-center" style="border-top: 1px solid black;">
                <ul class="list-inline mb4">
                    <span t-field="company.report_footer"/>
                </ul>
                <br/>
                <p>Page
                    <span class="page"/>
                    /
                    <span class="topage"/>
                </p>
            </div>
        </div>
    </template>

    <!-- Template principal corrigé -->
<template id="pfe.report_dissertation">
    <t t-call="web.html_container">
        <t t-call="pfe.pfe_layout">
            <t t-set="user_lang" t-value="user.lang"/>
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family:arial; padding: 30px;">
                    <div class="oe_structure"/>

                    <!-- Titre -->
                     <br/>
                    <div style="text-align: center; margin-top: 30px;" t-if="user_lang == 'ar_SY'">
                        <h3 style="direction: rtl;">
                            <strong>اقتراح موضوع مذكرة التخرج </strong>
                        </h3>
                    </div>
                    <div style="text-align: center; margin-top: 30px;" t-if="user_lang != 'ar_SY'">
                        <h3>
                            <strong>Dissertation Topic Proposal </strong>
                        </h3>
                    </div>

                    <br/>

                    <!-- Version arabe -->
                    <div t-if="user_lang == 'ar_SY'" style="direction: rtl; text-align: right;">
                        <p><strong>لطلبة السنة:</strong> <span t-esc="doc.group_id.student_ids.education_level_id.name or ''"/></p>
                        <p><strong>الإختصاص:</strong> <span t-esc="doc.group_id.student_ids.specialization_id.name or ''"/></p>
                        <p><strong>الموضوع :</strong><br/> <span t-esc="doc.title or ''"/></p>
                        <p><strong>ملخص حول الموضوع :</strong><br/>
                            <t t-if="doc.description"><t t-raw="doc.description"/></t>
                        </p>
                        <p><strong>قائمة المراجع :</strong><br/> <span t-esc="doc.reference or ''"/></p>

                        <br/><br/><br/>
                        <p><strong>إمضاء الأستاذ (ة) :</strong> <span t-esc="doc.supervisor_id.name or ''"/></p>
                        <br/><br/>
                        <p><strong>إمضاء رئيس القسم :</strong> ..............................................</p>
                    </div>

                    <!-- Version anglaise -->
                    <div t-if="user_lang != 'ar_SY'" style="direction: ltr; text-align: left;">
                        <p><strong>Year Level:</strong> <span t-esc="doc.group_id.student_ids.education_level_id.name or ''"/></p>
                        <p><strong>Speciality:</strong> <span t-esc="doc.group_id.student_ids.specialization_id.name or ''"/></p>
                        <p><strong>Topic:</strong><br/> <span t-esc="doc.title or ''"/></p>
                        <p><strong>Summary:</strong><br/>
                            <t t-if="doc.description"><t t-raw="doc.description"/></t>
                        </p>
                        <p><strong>References:</strong><br/> <span t-esc="doc.reference or ''"/></p>

                        <br/><br/><br/>
                        <p><strong>Supervisor Signature:</strong> <span t-esc="doc.supervisor_id.name or ''"/></p>
                        <br/><br/>
                        <p><strong>Head of Department Signature:</strong> ..............................................</p>
                    </div>
                </div>
            </t>
        </t>
    </t>
</template>



    <!-- Rapport PDF corrigé -->
    <report
            id="report_dissertation1"
            model="pfe.dissertation"
            string="Certificate of Supervision"
            report_type="qweb-pdf"
            name="pfe.report_dissertation"
            file="pfe.report_dissertation"
    />

</odoo>
